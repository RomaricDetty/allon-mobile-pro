{
    "expo": {
        "name": "AllOn Pro",
        "slug": "allon-mobile-pro",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "splash": {
            "image": "./assets/images/splash-icon-custom.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "scheme": "allonmobilepro",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.allonmobilepro",
            "infoPlist": {
                "UIViewControllerBasedStatusBarAppearance": false,
                "UILaunchStoryboardName": "SplashScreen",
                "NSLocationWhenInUseUsageDescription": "Allon Pro a besoin d'accéder à votre position pour suivre votre trajet en temps réel.",
                "NSLocationAlwaysAndWhenInUseUsageDescription": "Allon Pro a besoin d'accéder à votre position pour suivre votre trajet en temps réel.",
                "NSLocationAlwaysUsageDescription": "Allon Pro a besoin d'accéder à votre position pour suivre votre trajet en temps réel."
            }
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "permissions": [
                "android.permission.CAMERA",
                "android.permission.RECORD_AUDIO",
                "android.permission.ACCESS_FINE_LOCATION",
                "android.permission.ACCESS_COARSE_LOCATION",
                "ACCESS_BACKGROUND_LOCATION"
            ],
            "package": "com.allonmobilepro"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            [
                "expo-camera",
                {
                    "cameraPermission": "Permettre à Allon Mobile Pro d'accéder à votre caméra pour scanner les QR codes."
                }
            ],
            [
                "expo-location",
                {
                    "locationAlwaysAndWhenInUsePermission": "Allon Mobile Pro a besoin d'accéder à votre position pour suivre votre trajet en temps réel."
                }
            ],
            [
                "expo-maps",
                {
                    "requestLocationPermission": true,
                    "locationPermission": "Permettre à $(PRODUCT_NAME) d'accéder à votre position pour afficher votre emplacement sur la carte."
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}