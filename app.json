{
  "expo": {
    "name": "AllOn Pro",
    "slug": "mobile.app.allonpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon-custom.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "mobile.app.allonpro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mobile.app.allonpro",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "UILaunchStoryboardName": "SplashScreen",
        "NSLocationWhenInUseUsageDescription": "Allon Pro a besoin d'accéder à votre position pour suivre votre trajet en temps réel.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allon Pro a besoin d'accéder à votre position pour suivre votre trajet en temps réel.",
        "NSLocationAlwaysUsageDescription": "Allon Pro a besoin d'accéder à votre position pour suivre votre trajet en temps réel."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK"
      ],
      "package": "mobile.app.allonpro"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permettre à AllOn Pro d'accéder à votre caméra pour scanner les QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AllOn Pro a besoin d'accéder à votre position pour suivre votre trajet en temps réel.",
          "locationWhenInUsePermission": "AllOn Pro a besoin d'accéder à votre position pour suivre votre trajet en temps réel.",
          "locationAlwaysPermission": "AllOn Pro a besoin d'accéder à votre position en arrière-plan pour continuer le suivi même quand l'app est en arrière-plan.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMBX_MAPBOX_TOKEN": "sk.eyJ1IjoiZGV0dHktcm9tYXJpYyIsImEiOiJjbWwwczl5aXUwMDVnM3JxeW1vMjVmNmJnIn0.xFOZodZOoxrkwpw-vzjBFA"
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Permettre à $(PRODUCT_NAME) d'accéder à votre position pour afficher votre emplacement sur la carte."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "RNMBX_MAPBOX_TOKEN": "sk.eyJ1IjoiZGV0dHktcm9tYXJpYyIsImEiOiJjbWwwczl5aXUwMDVnM3JxeW1vMjVmNmJnIn0.xFOZodZOoxrkwpw-vzjBFA"
    }
  }
}
